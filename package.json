{
  "name": "huerto-urbano",
  "version": "1.0.0",
  "description": "App multiplataforma para gestionar un huerto urbano: temporadas, parcelas, siembras, riegos y cosechas.",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "expo-file-system": "~58.0.14",
    "expo-location": "~58.0.22",
    "expo-notifications": "~58.1.9",
    "expo-print": "~58.0.9",
    "expo-sharing": "~58.0.23",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "~0.21.4"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "e2e": "expo export --platform web && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react-native": "^14.1.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.15"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 20000,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ]
  }
}
